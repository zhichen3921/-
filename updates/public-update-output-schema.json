{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "generatedAt", "verifiedAt", "sources", "jobs"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-shenzhen-ai-v[1-9]\\d*$"
    },
    "generatedAt": {
      "type": "string"
    },
    "verifiedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "url"],
        "properties": {
          "name": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["company-career", "university-career", "public-aggregator"]
          },
          "url": { "type": "string" }
        }
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "company",
          "location",
          "url",
          "source",
          "verifiedAt",
          "description",
          "directions",
          "graduationYears",
          "curationNote",
          "review"
        ],
        "properties": {
          "title": { "type": "string" },
          "company": { "type": "string" },
          "location": { "type": "string" },
          "url": { "type": "string" },
          "source": { "type": "string" },
          "verifiedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": { "type": "string" },
          "directions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "graduationYears": {
            "type": "array",
            "items": { "type": "string" }
          },
          "curationNote": { "type": "string" },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["score", "verdict", "recommendation", "reasons", "matchedSkills"],
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "verdict": {
                "type": "string",
                "enum": ["good", "unknown", "bad"]
              },
              "recommendation": { "type": "string" },
              "reasons": {
                "type": "array",
                "items": { "type": "string" }
              },
              "matchedSkills": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
